# Copy this to .env for local dev/testing (never commit the real .env — it's
# already covered by the repo's root .gitignore, which ignores `.env` at any depth).
# In production, set these via cPanel → Setup Node.js App → your app → "Edit" →
# environment variables instead of shipping a .env file.

PORT=3000

# Full origin the site is served from — used to build Stripe's success/cancel URLs.
# No trailing slash.
DOMAIN=https://thescrapman.uk

# From your Supabase project: Settings -> API.
SUPABASE_URL=https://bvfhcwfifjyododertvx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
# The SECRET service_role key (Settings -> API -> "service_role"). This bypasses
# Row Level Security — it must only ever live server-side, never in any file the
# browser loads.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Stripe dashboard -> Developers -> API keys. Use the TEST/sandbox keys (sk_test_...)
# while building this out — see the Stripe setup skill / README for how to get them.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen` (local dev) or the webhook endpoint's dashboard page (prod).
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — printed by `npm run setup-stripe-products` (scripts/setup-stripe-products.js).
STRIPE_PRICE_UNLOCK=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BOOST=price_...

# metals.dev API key (https://metals.dev) — powers the collector dashboard's live
# material price feed (GET /metal-prices). Without this set, that endpoint responds
# with live:false and the client falls back to its own static guide rates.
METALS_DEV_API_KEY=...
